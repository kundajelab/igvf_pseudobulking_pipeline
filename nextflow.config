manifest {
    contributors = [
        [name: 'Salil Deshpande', email: 'salil512@stanford.edu'],
        [name: 'Ted Brookings', email: 'tedbrookings@stanford.edu'],
    ]
    homePage = 'https://github.com/kundajelab/igvf_pseudobulking_pipeline'
    description = 'Workflow for downloading and pseudobulking IGVF processed data'
    mainScript = 'main.nf'
    version = '0.2.0'
    nextflowVersion = '>=25.4.6,<26.0.0' // DSL2 is the default starting here
}

plugins {
    id 'nf-schema@2.4.2'
    id 'nf-dotenv@1.0.0'
}

// Make "--help" print the parameters from nextflow_schema.json, and "--help <param>" print the
// detail for one of them. nf-schema handles this itself and exits before the workflow runs, so no
// params.help branch is needed in main.nf.
validation {
    help {
        enabled = true
        command = "nextflow run . --metadata_file <accession|file.tsv> --principal_analysis <accession> -profile slurm,apptainer"
    }
}

resume = true

params {
    // NOTE: both of these are required, and are declared with their descriptions in
    // nextflow_schema.json, which is what validateParameters() reads. They are declared null here as
    // well so that the config stays parseable when one is not supplied: workDir, outputDir and the
    // trace paths all interpolate principal_analysis while the config is being parsed, so with no
    // declared key at all nextflow dies with "Unknown config attribute" before validateParameters()
    // can report which required param is actually missing. The "?." in those paths stops a null from
    // becoming a NullPointerException during that parse.
    metadata_file = null
    principal_analysis = null
    // IGVF mode for upload. Can be "prod", "staging", or "sandbox". Default is "prod".
    igvf_mode = "prod"
    // If true, do not actually upload to IGVF, the upload script just checks for schema compliance.
    igvf_dry_run = true
    // comma-separated list of accessions to process. If null, process all accessions in the metadata file.
    accessions = null
    // Species to process (e.g. "human" or "mouse")
    species = null
    // Number of "top" peaks to keep
    num_top_peaks = 300000
    // Minimum overlap for peaks in bedtools intersect
    min_overlap = 0.5
    // IGVF url for downloading metadata for accessions
    igvf_metadata_url = "https://api.data.igvf.org/analysis-sets"
    igvf_fragments_url = "https://api.data.igvf.org/tabular-files"
    igvf_counts_matrix_url = "https://api.data.igvf.org/matrix-files"
    // folder to store all pipeline temporary files and outputs
    workspace = "workspace"
    // publishDir mode for outputs
    publish_mode = "symlink"
    // How many CPUS should SPLIT_FRAGMENTS jobs use? In a local executor, there is a lot of
    // contention for file IO, so 6 is max throughput.
    split_fragments_cpus = 6
    // Should SPLIT_FRAGMENTS jobs run in parallel?contend with one another for resources?
    // If true, run sequentially because it will actually be slower to run in parallel.
    // If false, run in parallel.
    // If null, automatically decide based on profile. Typically on the cluster they will not have
    // contention, but locally they may be starved for IO.
    split_fragments_parallel = null
    // queue for running slurm jobs
    slurm_queue = "owners"
    // how many slurm jobs may be submitted (pending + running) at once. Must stay under the queue's
    // MaxSubmitJobsPU: 3000 on owners, 2000 on normal.
    slurm_queue_size = 1000
    // slurm jobs may be preempted, so allow more retries there than locally
    preemptible_max_retries = 5
    // only retry due to out-of-memory errors this many times
    oom_max_retries = 2
    trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
}

workDir = "${params.workspace}/${params.principal_analysis?.replace(",", "-")}/work"
outputDir = "${params.workspace}/${params.principal_analysis?.replace(",", "-")}/output/"

process {
    // stop on errors, log commands
    shell = ['/bin/bash', '-euxo', 'pipefail']
    // tasks that need to retry will override this:
    maxRetries = 0
}

profiles {
    arm {
        // docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    local {
        process.executor = 'local'
        params.split_fragments_parallel = params.split_fragments_parallel == null ? false : params.split_fragments_parallel
        process {
            executor = "local"
            // Processes that estimate their own memory (see modules/retry.nf) can ask for more than
            // this machine has, and the local executor refuses those outright with "Process
            // requirement exceeds available memory -- req: X; avail: Y" rather than just running
            // them. Clamp every request down to what is actually here.
            // NOTE: deliberately not applied to the slurm profile. Clamping is recorded in the task
            // trace, so once a request hits the ceiling oomMaxRetriesOf can no longer tell how many
            // times it has doubled and stops giving up on hopeless tasks.
            resourceLimits = [
                memory: nextflow.util.SysHelper.getAvailMemory(),
                cpus: nextflow.util.SysHelper.getAvailCpus(),
            ]
            // if something is likely out of memory and has more than 0 retries: retry
            // otherwise terminate
            errorStrategy = {
                task.maxRetries > 0 && task.exitStatus in 130..145 ?
                'retry' :
                'terminate'
            }
            // tasks that need to retry will override this:
            maxRetries = 0
        }
    }
    slurm {
        executor {
            // Nextflow's grid default is 100, which throttles submission well below what the
            // cluster allows (owners QOS permits 3000 submitted jobs per user). Processes with
            // hundreds of short tasks otherwise pay the queue wait once per 100-task wave.
            queueSize = params.slurm_queue_size
        }
        process {
            executor = 'slurm'
            queue = params.slurm_queue
            clusterOptions = "--export=ALL "
            // owners queue jobs get preempted (signalled with exit status 15); retry
            // those the same as obvious out-of-memory errors.
            // A task that stalls at startup (e.g. wedged $SCRATCH mount on the compute node) never
            // gets to run its own bash traps, so it never writes .exitcode. Once SLURM kills it at
            // the walltime and the job leaves the queue, nextflow waits exitReadTimeout and then
            // reports exitStatus as Integer.MAX_VALUE (or null). Treat that like a preemption and
            // retry, which will almost always land on a different node.
            // NOTE: the queue is chosen inside the closure rather than using it to pick between two
            // closures. A closure only counts as a dynamic directive to nextflow's config parser
            // when it is the direct value of the assignment, so the two-closure form makes `task`
            // undefined as far as "nextflow lint" is concerned.
            errorStrategy = {
                def vanished = task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE
                def retryable = vanished || task.exitStatus in 130..145
                params.slurm_queue == "owners" ?
                    (retryable || task.exitStatus == 15 ? 'retry' : 'terminate') :
                    (task.maxRetries > 0 && retryable ? 'retry' : 'terminate')
            }
            // tasks that need OOM-based retries will override this:
            maxRetries = params.slurm_queue == "owners" ? params.preemptible_max_retries : 0
        }
        params.split_fragments_parallel = params.split_fragments_parallel == null ? true : params.split_fragments_parallel
    }
    conda {
        conda.enabled = true
    }
    docker {
        docker.enabled = true
    }
    apptainer {
        apptainer.enabled = true
    }
}

conda {
    cacheDir = "${params.workspace}/conda_cache"
    useMicromamba = true
    createTimeout = '1 h'
}

apptainer {
    autoMounts = true
    cacheDir = "${params.workspace}/apptainer_cache"
}

timeline {
    enabled = true
    overwrite = true
    file    = "${params.workspace}/${params.principal_analysis?.replace(",", "-")}/trace/execution_timeline_${params.trace_timestamp}.html"
}
report {
    enabled = true
    overwrite = true
    file    = "${params.workspace}/${params.principal_analysis?.replace(",", "-")}/trace/execution_report_${params.trace_timestamp}.html"
}
trace {
    enabled = true
    overwrite = true
    file    = "${params.workspace}/${params.principal_analysis?.replace(",", "-")}/trace/execution_trace_${params.trace_timestamp}.txt"
}
dag {
    enabled = true
    overwrite = true
    file    = "${params.workspace}/${params.principal_analysis?.replace(",", "-")}/trace/pipeline_dag_${params.trace_timestamp}.html"
}
